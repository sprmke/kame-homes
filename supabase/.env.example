# Edge secrets — copy to .env.local (local serve) or Dashboard → Edge Functions → Secrets.
# Email routing, payment QR, Telegram bots → DB (app_settings / org_settings), not env.
# ./dev.sh injects SUPABASE_URL + service role — omit here when using dev.sh.
# Full inventory: docs/architecture/validation-and-env.md

# Env
ENVIRONMENT=development

# Scripts (optional)
# PROD_DB_URL=postgresql://postgres.<ref>:...@....pooler.supabase.com:5432/postgres

# URLs
# PUBLIC_GUEST_APP_ORIGIN=http://localhost:5173  # Hosted Checkout success/cancel URLs (org billing)
# PUBLIC_API_URL=https://your-ngrok.ngrok-free.dev

# Auth
# ADMIN_ALLOWED_EMAILS=
# SUPER_ADMIN_EMAILS=

# Email
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_INBOUND_WEBHOOK_SECRET=
# RESEND_APPROVAL_INBOUND_DOMAIN=
# SUPPORT_TEAM_EMAIL=

# Crypto (openssl rand -hex 32)
# GMAIL_OAUTH_TOKEN_ENCRYPTION_KEY=
# SETTINGS_VERIFICATION_SECRET=

# Anti-spam — Cloudflare Turnstile (docs/workflow/for-testing/captcha-anti-spam-hardening.md)
# Used by _shared/captcha.ts for the public write endpoints (submit-form etc).
# Local: Cloudflare's always-passes test secret is 1x0000000000000000000000000000000AA
# (always-fails: 2x0000000000000000000000000000000AA). Also add to ui/.env.development
# for local GoTrue [auth.captcha] when you enable it there.
# TURNSTILE_SECRET_KEY=
# CAPTCHA_MODE=            # enforce | monitor | disabled (default: enforce when secret set, else disabled)

# Guest booking access tokens (cost-abuse plan Phase 2.1)
# GUEST_BOOKING_ACCESS_SECRET=   # optional; falls back to SUPABASE_SERVICE_ROLE_KEY
# GUEST_BOOKING_ACCESS_ENFORCE=  # true → get-form/sd-form/review require ?access= (staged rollout)

# Social fallbacks (prefer DB)
# FACEBOOK_REVIEWS_URL=

# AI
# GEMINI_API_KEYS=key1,key2
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Optional local override when the default feature model is quota-exhausted (pricing metadata unchanged):
# GEMINI_MODEL_OVERRIDE_DASHBOARD_ASSISTANT=gemini-3.5-flash-lite
# GEMINI_MODEL_OVERRIDE=gemini-3.5-flash-lite


# Meta
# META_APP_ID=
# META_APP_SECRET=
# META_INBOX_TOKEN_ENCRYPTION_KEY=
# META_WEBHOOK_VERIFY_TOKEN=
# META_OAUTH_ALLOWED_RETURN_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PayMongo
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=

# Jamendo
# JAMENDO_CLIENT_ID=

# Web Push (PWA notifications) — node scripts/pwa/generate-vapid-keys.mjs
# VAPID_KEYS={"publicKey":{...JWK...},"privateKey":{...JWK...}}
# VAPID_SUBJECT=mailto:ops@yourdomain
# PUSH_FANOUT_SECRET=   # shared secret the notifications→pg_net trigger sends to push-fanout

# Cron secrets (optional — see docs/archive/operations/scheduled-jobs-and-testing.md)
# SD_REFUND_CRON_SECRET=
# TELEGRAM_CRON_SECRET=
# TELEGRAM_STAFF_CRON_SECRET=
# TELEGRAM_ADMIN_CRON_SECRET=
# TELEGRAM_FINANCE_CRON_SECRET=
# TELEGRAM_MAINTENANCE_CRON_SECRET=
# PARKING_BROADCAST_EXPIRE_CRON_SECRET=
# PARKING_REMINDER_CRON_SECRET=
# CONTRACT_EXPIRY_CRON_SECRET=
# DASHBOARD_ASSISTANT_EXPIRE_CRON_SECRET=
# META_INBOX_WEBHOOK_HEALTHCHECK_CRON_SECRET=
# PLATFORM_BILLING_CRON_SECRET=

# Optional — product name in transactional email shells only (not the browser UI; use VITE_PLATFORM_* in ui/.env*)
# Unset or Stays → Kame Homes
# PLATFORM_APP_NAME=Kame Homes
# Do NOT put PLATFORM_CONTACT_EMAIL here — that is UI-only as VITE_PLATFORM_CONTACT_EMAIL.

# Guest booking access tokens (cost-abuse §2.1)
# GUEST_BOOKING_ACCESS_SECRET=           # optional; falls back to SUPABASE_SERVICE_ROLE_KEY
# GUEST_BOOKING_ACCESS_ENFORCE=true      # require ?access= on get-form / sd-form / review
# GUEST_BOOKING_ACCESS_LEGACY_GRACE_DAYS=30  # bare UUID still works for this many days after booking created

# Platform AI spend ceiling (USD/day across all orgs; 0 = off)
# AI_PLATFORM_DAILY_COST_USD_CAP=150

# AI assistant attachment retention (nightly with dashboard-assistant-expire cron)
# AI_ASSISTANT_ATTACHMENT_RETENTION_DAYS=90

# Observability (optional) — server-side exception capture, see _shared/posthog.ts
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Calendar sync / Smart Pricing / Superhost (optional cron gates)
# CALENDAR_SYNC_CRON_SECRET=
# CALENDAR_SYNC_MIN_INTERVAL_MINUTES=30
# SMART_PRICING_CRON_SECRET=
# SUPERHOST_ASSESSMENT_CRON_SECRET=
# ANALYTICS_AI_REVIEW_CRON_SECRET=
# PROPERTY_PAGE_VIEWS_PRUNE_CRON_SECRET=
# ACTIVITY_LOG_RETENTION_CRON_SECRET=
