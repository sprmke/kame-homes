# Production bootstrap — copy to .env.prod.local.
# There is ONE Supabase project (the same one dev uses), so this file no longer carries a
# separate mt-prod ref or a legacy deny-list.

# Project
MT_PROD_PROJECT_REF=replace-me
MT_PROD_SUPABASE_URL=https://<ref>.supabase.co
MT_PROD_SERVICE_ROLE_KEY=replace-me
# MT_PROD_DB_URL=postgresql://...

# Env
ENVIRONMENT=production

# Auth
ADMIN_ALLOWED_EMAILS=you@example.com
SUPER_ADMIN_EMAILS=you@example.com

# Email
RESEND_API_KEY=re_replace_me

# Crypto · URLs · AI · PayMongo — see .env.example
