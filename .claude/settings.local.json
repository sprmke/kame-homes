{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(xargs ls:*)",
      "mcp__ide__getDiagnostics",
      "Bash(npx tsc:*)",
      "Bash(bunx tsc:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(ln -s ../.mcp.json .cursor/mcp.json)",
      "mcp__playwright__browser_run_code_unsafe",
      "Bash(curl -s -w '\\\\nHTTP_STATUS:%{http_code}\\\\n' -X PATCH http://127.0.0.1:54321/functions/v1/ai-platform-settings?org_id=__TRACKED_VAR__ -H 'Authorization: Bearer __CMDSUB_OUTPUT__' -H 'apikey: __TRACKED_VAR__' -H 'Content-Type: application/json' -d '{\"dailyCallLimit\": 1}')",
      "Bash(curl -s -w '\\\\nHTTP_STATUS:%{http_code}\\\\n' -X POST http://127.0.0.1:54321/functions/v1/dashboard-assistant?org_id=__TRACKED_VAR__ -H 'Authorization: Bearer __CMDSUB_OUTPUT__' -H 'apikey: __TRACKED_VAR__' -H 'Content-Type: application/json' -d '{\"message\": \"quota test message unique\"}')",
      "Bash(curl -s -w '\\\\nHTTP_STATUS:%{http_code}\\\\n' -X POST http://127.0.0.1:54321/functions/v1/dashboard-assistant?org_id=__TRACKED_VAR__ -H 'Authorization: Bearer __CMDSUB_OUTPUT__' -H 'apikey: __TRACKED_VAR__' -H 'Content-Type: application/json' -d '{\"message\": \"quota test message unique 2\"}')",
      "Bash(bash scripts/dev/workflow-move.sh start help-support-center)",
      "Bash(bun scripts/sync-ai-knowledge-base.ts --dry-run)"
    ]
  },
  "enabledMcpjsonServers": [
    "supabase",
    "playwright",
    "context7",
    "markitdown"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
