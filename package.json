{
  "name": "guest-form-management",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "ui"
  ],
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "postinstall": "node ./scripts/dev/dedupe-react-types.mjs",
    "prepare": "husky",
    "lint": "cd ui && bun run lint",
    "lint:fix": "cd ui && bun run lint:fix",
    "check:filenames": "./scripts/dev/check-ui-filename-conventions.sh",
    "audit:deps": "bun x knip --no-exit-code",
    "audit:edge-functions": "node scripts/dev/audit-edge-functions.mjs",
    "check:edge-conformance": "node scripts/dev/audit-edge-functions.mjs --check",
    "audit:auth-matrix": "node scripts/dev/audit-auth-matrix.mjs",
    "check:auth-matrix": "node scripts/dev/audit-auth-matrix.mjs --check",
    "check:authenticated-rate-limit": "bash scripts/dev/check-authenticated-rate-limit.sh",
    "perf:load-test": "echo 'Install k6 then: BASE_URL=<hosted-dev> k6 run scripts/performance/load-test/mixed.js'",
    "check:ai-tooling-sync": "bash scripts/dev/check-ai-tooling-sync.sh",
    "check:workflow-scratchpads": "bash scripts/dev/check-workflow-scratchpads.sh",
    "sync:workflow-scratchpads": "bash scripts/dev/sync-workflow-scratchpads.sh",
    "setup:ai-tooling": "bash scripts/dev/setup-ai-tooling.sh",
    "cleanup:claude-mem": "bash scripts/dev/cleanup-claude-mem.sh",
    "setup:agents-skills": "bash scripts/dev/setup-agents-skills.sh",
    "setup:impeccable": "bash scripts/dev/setup-impeccable.sh",
    "setup:playwright-cli": "bash scripts/dev/setup-playwright-cli.sh",
    "setup:design-md": "bash scripts/dev/setup-design-md.sh",
    "type-check": "cd ui && bun run type-check",
    "test": "cd ui && bun run test",
    "test:coverage:lib": "cd ui && bun run test:coverage:lib",
    "check:edge-types": "bash scripts/dev/check-edge-types.sh",
    "test:edge": "bash -c 'command -v deno >/dev/null || export PATH=\"$HOME/.deno/bin:$PATH\"; deno test --allow-env --allow-net --allow-read --allow-import --ignore=\"supabase/functions/**/*integration_test.ts\" supabase/functions/_shared/'",
    "test:edge:handlers": "bash -c 'command -v deno >/dev/null || export PATH=\"$HOME/.deno/bin:$PATH\"; deno test --allow-env --allow-net --allow-read --allow-import supabase/functions/tests/ --ignore=\"supabase/functions/tests/*integration_test.ts\" --ignore=\"supabase/functions/tests/assistantParityLiveGemini.integration_test.ts\"'",
    "test:auth-parity-seed": "bash -c 'command -v deno >/dev/null || export PATH=\"$HOME/.deno/bin:$PATH\"; deno test --allow-env --allow-net --allow-read supabase/functions/tests/authParitySeed.test.ts'",
    "test:assistant-parity": "bash -c 'command -v deno >/dev/null || export PATH=\"$HOME/.deno/bin:$PATH\"; deno test --allow-env --allow-net --allow-read supabase/functions/tests/assistantToolCatalog.test.ts supabase/functions/tests/assistantOrgPermissionLeaves.test.ts supabase/functions/tests/assistantAttachmentApply.test.ts supabase/functions/tests/assistantParityLocal.integration_test.ts'",
    "test:assistant-parity:live": "bash scripts/dev/run-assistant-parity-live-gemini.sh",
    "test:media:quality": "node scripts/media/quality-check.mjs",
    "media:storage-audit": "bun scripts/media/storage-audit.ts",
    "media:ab-compare": "node scripts/media/build-ab-compare.mjs",
    "ci:quality": "./scripts/dev/ci-quality-gate.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,mdc,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,mdc,css}\"",
    "preview:emails:db": "node scripts/preview/preview-emails-from-db.mjs",
    "preview:emails:serve": "cd supabase/functions/_shared/email-templates && python3 -m http.server 3334",
    "preview:emails": "bun run preview:emails:db && bun run preview:emails:serve",
    "dev": "./dev.sh",
    "dev:ui": "cd ui && bun run dev",
    "dev:api": "bash -c './scripts/dev/build-local-functions-env.sh >/dev/null && ./scripts/dev/bunx --bun supabase@latest functions serve --env-file ./supabase/.temp/functions-serve.env'",
    "dev:remote-api": "./scripts/dev/run-remote-functions-serve.sh",
    "start:supabase": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest start",
    "status:supabase": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest status",
    "stop:supabase": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest stop",
    "stop:supabase:clean": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest stop --no-backup --yes",
    "db:reset": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest db reset",
    "db:migrate": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest migration up --local --include-all",
    "seed:mock-listings": "node scripts/dev/generate-mock-listings-seed.mjs",
    "seed:monaco-2612": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest db query --local -f scripts/dev/seed-monaco-2612-demo-data.sql",
    "seed:monaco-2612-media": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest db query --local -f scripts/dev/seed-monaco-2612-mock-media.sql",
    "seed:marketing-guest-reviews": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest db query --local -f scripts/dev/seed-marketing-guest-reviews.sql",
    "seed:host-announcements": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest db query --local -f scripts/dev/seed-host-announcements.sql",
    "seed:analytics-demo": "./scripts/dev/run-with-ui-dev-env.sh ./scripts/dev/bunx --bun supabase@latest db query --local -f scripts/dev/seed-analytics-demo-data.sql",
    "sync:prod-data": "./scripts/data/sync-prod-public-data-to-local.sh",
    "sync:prod-data:restore": "RESTORE_ONLY=1 ./scripts/data/sync-prod-public-data-to-local.sh",
    "sync:ai-knowledge-base": "bun scripts/sync-ai-knowledge-base.ts",
    "sync:ai-knowledge-base:dev": "bun scripts/sync-ai-knowledge-base.ts --dev",
    "build:ui": "cd ui && bun run build",
    "build": "bun run build:ui",
    "check:budgets": "node scripts/performance/check-budgets.mjs && node scripts/performance/analyze-chunk-graph.mjs",
    "perf:baseline": "node scripts/performance/capture-baseline.mjs",
    "perf:chunk-graph": "node scripts/performance/analyze-chunk-graph.mjs",
    "perf:lighthouse": "node scripts/performance/lighthouse-routes.mjs",
    "perf:edge-latency": "node scripts/performance/edge-latency-baseline.mjs",
    "verify:deployed-preview": "node scripts/performance/verify-deployed-preview.mjs",
    "perf:pg-stat-statements": "bash scripts/performance/capture-pg-stat-statements.sh",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium-ci --project=mobile-chromium-smoke --project=tablet-chromium-smoke --grep @smoke",
    "test:e2e:ci": "playwright test --project=chromium-ci --grep @ci",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:parking": "playwright test ui/e2e/features/parking --project=chromium --grep-invert \"parking live local flow\"",
    "test:e2e:parking:headed": "playwright test ui/e2e/features/parking --project=chromium --grep-invert \"parking live local flow\" --headed",
    "test:e2e:parking:side-by-side": "playwright test ui/e2e/features/parking/flows/parkingGuestHostSideBySide.spec.ts --project=chromium-side-by-side",
    "test:e2e:parking:side-by-side:slow": "PLAYWRIGHT_SLOW_MO=600 PLAYWRIGHT_DEMO_PAUSE_MS=2000 playwright test ui/e2e/features/parking/flows/parkingGuestHostSideBySide.spec.ts --project=chromium-side-by-side",
    "test:e2e:parking:side-by-side:video": "PLAYWRIGHT_RECORD_VIDEO=1 playwright test ui/e2e/features/parking/flows/parkingGuestHostSideBySide.spec.ts --project=chromium-side-by-side",
    "test:e2e:parking:side-by-side:slow:video": "PLAYWRIGHT_RECORD_VIDEO=1 PLAYWRIGHT_SLOW_MO=600 PLAYWRIGHT_DEMO_PAUSE_MS=2000 playwright test ui/e2e/features/parking/flows/parkingGuestHostSideBySide.spec.ts --project=chromium-side-by-side",
    "test:e2e:parking:free-workflow": "playwright test ui/e2e/features/parking/property/propertyBookingFreeManualWorkflow.spec.ts --project=chromium",
    "test:e2e:parking:free-workflow:headed": "playwright test ui/e2e/features/parking/property/propertyBookingFreeManualWorkflow.spec.ts --project=chromium --headed",
    "test:e2e:parking:free-workflow:slow": "PLAYWRIGHT_SLOW_MO=1200 PLAYWRIGHT_DEMO_PAUSE_MS=3000 playwright test ui/e2e/features/parking/property/propertyBookingFreeManualWorkflow.spec.ts --project=chromium --headed",
    "test:e2e:parking:free-workflow:slow:video": "PLAYWRIGHT_RECORD_VIDEO=1 PLAYWRIGHT_SLOW_MO=1200 PLAYWRIGHT_DEMO_PAUSE_MS=3000 playwright test ui/e2e/features/parking/property/propertyBookingFreeManualWorkflow.spec.ts --project=chromium --headed",
    "test:e2e:parking:local": "PLAYWRIGHT_LOCAL_LIVE=1 playwright test ui/e2e/features/parking/live/parkingGuestHostLocal.spec.ts --project=chromium",
    "test:e2e:parking:local:headed": "PLAYWRIGHT_LOCAL_LIVE=1 playwright test ui/e2e/features/parking/live/parkingGuestHostLocal.spec.ts --project=chromium --headed",
    "test:e2e:parking:screens": "PLAYWRIGHT_CAPTURE_SCREENS=1 playwright test ui/e2e/features/parking --project=chromium --grep-invert \"parking live local flow\" && PLAYWRIGHT_CAPTURE_SCREENS=1 playwright test ui/e2e/features/parking/flows/parkingGuestHostSideBySide.spec.ts --project=chromium-side-by-side",
    "test:e2e:parking:screens:local": "PLAYWRIGHT_CAPTURE_SCREENS=1 PLAYWRIGHT_LOCAL_LIVE=1 playwright test ui/e2e/features/parking/live/parkingGuestHostLocal.spec.ts --project=chromium",
    "test:e2e:plans": "playwright test ui/e2e/features/plans --project=chromium",
    "test:e2e:plans:checkout": "playwright test ui/e2e/features/plans/org/orgPlanCheckout.spec.ts --project=chromium",
    "test:e2e:team:headed": "playwright test ui/e2e/features/team --project=chromium --headed",
    "test:e2e:assistant": "playwright test ui/e2e/features/assistant/assistantConfirmCards.spec.ts ui/e2e/features/assistant/assistantSmoke.spec.ts --project=chromium",
    "test:e2e:assistant:live": "PLAYWRIGHT_ASSISTANT_LIVE=1 playwright test ui/e2e/features/assistant/assistantLiveLocal.spec.ts --project=chromium",
    "test:e2e:vouchers": "playwright test ui/e2e/features/vouchers --project=chromium --grep-invert @demo",
    "test:e2e:vouchers:redemption": "playwright test ui/e2e/features/vouchers/guest/voucherWallet.spec.ts ui/e2e/features/vouchers/guest/voucherFormApply.spec.ts ui/e2e/features/vouchers/host/voucherBookingDetailPricing.spec.ts ui/e2e/features/vouchers/flows/voucherRedemptionMocked.spec.ts --project=chromium",
    "test:e2e:vouchers:redemption:headed": "playwright test ui/e2e/features/vouchers/guest/voucherWallet.spec.ts ui/e2e/features/vouchers/guest/voucherFormApply.spec.ts ui/e2e/features/vouchers/host/voucherBookingDetailPricing.spec.ts ui/e2e/features/vouchers/flows/voucherRedemptionMocked.spec.ts --project=chromium --headed",
    "test:e2e:vouchers:redemption:headed:slow": "PLAYWRIGHT_SLOW_MO=1200 PLAYWRIGHT_DEMO_PAUSE_MS=3000 playwright test ui/e2e/features/vouchers/guest/voucherWallet.spec.ts ui/e2e/features/vouchers/guest/voucherFormApply.spec.ts ui/e2e/features/vouchers/host/voucherBookingDetailPricing.spec.ts ui/e2e/features/vouchers/flows/voucherRedemptionMocked.spec.ts --project=chromium --headed",
    "test:e2e:vouchers:headed": "playwright test ui/e2e/features/vouchers --project=chromium --grep-invert @demo --headed",
    "test:e2e:vouchers:demo": "playwright test ui/e2e/features/vouchers/flows/voucherRevealStylesDemo.spec.ts --project=chromium --headed",
    "test:e2e:vouchers:demo:slow": "PLAYWRIGHT_SLOW_MO=1200 PLAYWRIGHT_DEMO_PAUSE_MS=3000 playwright test ui/e2e/features/vouchers/flows/voucherRevealStylesDemo.spec.ts --project=chromium --headed",
    "test:e2e:vouchers:demo:video": "PLAYWRIGHT_RECORD_VIDEO=1 PLAYWRIGHT_SLOW_MO=1200 PLAYWRIGHT_DEMO_PAUSE_MS=3000 playwright test ui/e2e/features/vouchers/flows/voucherRevealStylesDemo.spec.ts --project=chromium --headed",
    "deploy:supabase": "./scripts/deploy/deploy-supabase.sh",
    "deploy:supabase:db": "./scripts/deploy/deploy-supabase.sh --db-only",
    "deploy:supabase:functions": "./scripts/deploy/deploy-supabase.sh --functions-only",
    "deploy:supabase:dev": "./scripts/deploy/deploy-supabase-dev.sh",
    "deploy:supabase:dev:db": "./scripts/deploy/deploy-supabase-dev.sh --db-only",
    "deploy:supabase:dev:functions": "./scripts/deploy/deploy-supabase-dev.sh --functions-only",
    "backup:supabase:dev": "./scripts/deploy/backup-supabase.sh dev",
    "backup:supabase:prod": "./scripts/deploy/backup-supabase.sh prod",
    "rehearsal:rollback:dev:preflight": "./scripts/deploy/hosted-dev-rollback-rehearsal-preflight.sh",
    "rollback:supabase:dev": "./scripts/deploy/rollback-supabase.sh dev",
    "rollback:supabase:prod": "./scripts/deploy/rollback-supabase.sh prod",
    "rollback:functions:dev": "./scripts/deploy/rollback-functions.sh dev",
    "rollback:functions:prod": "./scripts/deploy/rollback-functions.sh prod",
    "migrations:status:dev": "./scripts/deploy/migration-status.sh dev",
    "migrations:status:prod": "./scripts/deploy/migration-status.sh prod",
    "env:status": "./scripts/dev/check-linked-project.sh",
    "env:reorganize": "bun scripts/dev/reorganize-env-files.mjs",
    "env:sync:dev": "bun scripts/dev/sync-dev-env.mjs",
    "env:sync:vercel:dev": "bun scripts/dev/sync-vercel-dev-env.mjs",
    "env:sync:all": "bun scripts/dev/sync-all-env.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "@playwright/cli": "^0.1.17",
    "@playwright/test": "^1.62.1",
    "chrome-launcher": "^1.2.1",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1"
  }
}
