# UI — copy to .env.development (local) or .env.production (build).
# VITE_* is exposed to the browser. GOOGLE_* is local GoTrue only.
# Other setups: .env.development.dev.example · .env.development.local.example
# Full inventory: docs/architecture/validation-and-env.md

# App
VITE_NODE_ENV=development

# Supabase (/functions/v1 suffix required)
VITE_SUPABASE_URL=https://<ref>.supabase.co/functions/v1
VITE_API_URL=https://<ref>.supabase.co/functions/v1
VITE_SUPABASE_ANON_KEY=replace-me
# VITE_SUPABASE_PROJECT_URL=https://<ref>.supabase.co

# Admin UI (optional — server uses SUPER_ADMIN_EMAILS)

# Platform operator branding — browser UI only (VITE_ prefix required)
# Defaults to Kame Homes when unset (or when set to the retired placeholder Stays).
# VITE_PLATFORM_APP_NAME=Kame Homes
# VITE_PLATFORM_CONTACT_EMAIL=support@example.com
# Optional footer / More-sheet contact + socials — each is hidden when unset (https URLs only)
# VITE_PLATFORM_CONTACT_PHONE=+63 917 000 0000
# VITE_PLATFORM_SOCIAL_FACEBOOK=https://facebook.com/yourpage
# VITE_PLATFORM_SOCIAL_INSTAGRAM=https://instagram.com/yourhandle
# VITE_PLATFORM_SOCIAL_TWITTER=https://x.com/yourhandle

# Maps (optional)
# VITE_GOOGLE_MAPS_API_KEY=
# Resize public listing photos with Supabase Storage image transformations (plan must enable them)
# VITE_SUPABASE_IMAGE_TRANSFORMS=true

# Anti-spam — Cloudflare Turnstile site key (docs/workflow/in-progress/production-readiness/audits/captcha-anti-spam-hardening.md)
# Unset → CAPTCHA widget renders nothing and forms fall back to heuristics + rate limit.
# Local test key (always passes): 1x00000000000000000000AA
# VITE_TURNSTILE_SITE_KEY=

# Observability (optional) — product analytics only. Error monitoring lives in Sentry
# (below); PostHog never captures exceptions.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# Production first-party ingest (kame-homes Vercel): set api_host to /ingest via:
# VITE_POSTHOG_INGEST_PATH=/ingest
# Dual-track legacy prod: VITE_APP_TRACK=legacy
# Session replay (off by default in prod): VITE_POSTHOG_SESSION_REPLAY=true

# Observability — error monitoring. Sentry owns every error; PostHog does not.
# Web project DSN (`kame-homes-web`), safe to expose to the browser. Unset → Sentry no-ops.
# The edge project has a different DSN (SENTRY_DSN in supabase/.env.local) — never reuse
# the web DSN on the edge.
# VITE_SENTRY_DSN=
# Sampled performance tracing: production 0.05, preview 0.2, local 0.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Observability — source map upload (optional, build-time only, Vercel/CI build env —
# NOT VITE_* — never bundled to the browser). Organization token; Sentry locks
# organization tokens to `org:ci` (source maps + releases). Unset → plugin skipped.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=kame-tech
# SENTRY_PROJECT=kame-homes-web

# Observability — the PostHog personal API key is retired (source maps moved to Sentry).
# POSTHOG_PERSONAL_API_KEY / POSTHOG_PROJECT_ID are removed at Phase P1 of the split.

# Image upload optimization (docs/architecture/storage.md §7.1)
# VITE_DISABLE_IMAGE_OPTIMIZATION=1
# VITE_IMAGE_OPT_SURFACES=   # unset = all groups except guest-documents; all | none | CSV rollout groups

# Web Push (PWA notifications) — base64url raw VAPID public key.
# Generate with: node scripts/pwa/generate-vapid-keys.mjs  (see docs/architecture/pwa.md)
# VITE_VAPID_PUBLIC_KEY=

# GoTrue local OAuth
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-secret

# VITE_INBOX_MOCK_DATA=true
