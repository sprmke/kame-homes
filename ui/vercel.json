{
  "framework": "vite",
  "installCommand": "cd .. && rm -rf node_modules ui/node_modules && bun install && node ./scripts/dev/dedupe-react-types.mjs",
  "buildCommand": "bun run build",
  "redirects": [
    {
      "source": "/form",
      "has": [
        {
          "type": "host",
          "value": "kamehomes.space"
        }
      ],
      "destination": "https://kamespace.com/properties/kame-home/form",
