# Dependencies
**/node_modules
**/.pnp
**/.pnp.js

# Testing
**/coverage

# Production
**/dist
**/build

# Environment files
**/.env
**/.env.local
**/.env.development
**/.env.development.dev
**/.env.development.local
**/.env.test
**/.env.production
**/.env-backups
supabase/.env.dev.local
supabase/.env.prod.local
supabase/.env.*.local

# Deploy artifacts (DB backups, deploy audit log — may contain PII/refs, never commit)
backups/
backup/
.worktrees/

# OAuth client credential / token files (Gmail, etc. — never commit real credentials)
**/gmail-credentials.json
**/credentials.json
**/token.json

# Logs
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
.DS_Store
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

# TypeScript
**/*.tsbuildinfo

# Vite
**/.vite/

# UI specific
ui/.vite/
ui/dist/

# API specific
api/dist/
api/build/

# Temporary files
**/tmp/
**/temp/
supabase/.temp/

# Manual Postgres dumps from production (contain PII)
supabase_backup_*.sql
supabase_backup*.dump

# Local development
**/.local

# Obsidian local UI state (vault content stays tracked)
docs/.obsidian/workspace.json
docs/.obsidian/graph.json
docs/workflow/planned/production-readiness-checklist/baselines/.artifact-download/

# Tests / local agent tooling (keep .fallowrc.json tracked)
.playwright-mcp/
.playwright-cli/
.playwright/
playwright-report/
test-results/
# Local Playwright screen captures — ignored so they cannot be committed; git leaves
# ignored files on disk when switching branches (only tracked files are updated).
ui/screen-tmp/*
!ui/screen-tmp/.gitkeep
# Stray screenshots dumped at repo root by Playwright / design QA — never belong in git
/*.png
/*.jpg
/*.jpeg
/*.webp
.worktrees/
.superpowers/
.impeccable/
.fallow/

# Personal Claude Code overrides (team config is .claude/settings.json)
.claude/settings.local.json

# Superpowers lean mode session marker (hooks — local only)
.cursor/.superpowers-lean-active

# OpenCode local plugin install cache (committed config is opencode.json + .opencode/)
.opencode/node_modules/
.opencode/package-lock.json

cli-develop
.vercel
